# Sostituire example.com con il dominio reale.
example.com {
	encode zstd gzip

	# Il relay WebSocket ascolta in locale sulla 9081. Il client riceve
	# ROBLOXWEB_WS_URL=wss://example.com/ws dall'API.
	handle /ws* {
		reverse_proxy 127.0.0.1:9081
	}

	# Sito statico + API JSON + thumbnail.
	handle {
		request_body {
			max_size 4MB
		}
		reverse_proxy 127.0.0.1:9080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/robloxweb.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
